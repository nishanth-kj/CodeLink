{
  "js/ts.tsdk.path": "extension/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "files.exclude": {
    "**/out": true,
    "**/dist": true,
    "core/target": true
  },
  "search.exclude": {
    "**/out": true,
    "**/dist": true,
    "core/target": true,
    "**/node_modules": true
  },
  "editor.formatOnSave": true,
  "rust-analyzer.linkedProjects": [
    "core/Cargo.toml"
  ],
  "codelink.remote.enabled": true,
  "codelink.security.requireAuth": false
}
