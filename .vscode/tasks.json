{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "extension: watch",
      "type": "npm",
      "script": "watch",
      "path": "extension",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "extension: build",
      "type": "npm",
      "script": "build",
      "path": "extension",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "core: build",
      "type": "shell",
      "command": "cargo build --manifest-path core/Cargo.toml",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "core: build (release)",
      "type": "shell",
      "command": "cargo build --release --manifest-path core/Cargo.toml",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "core: test",
      "type": "shell",
      "command": "cargo test --manifest-path core/Cargo.toml",
      "problemMatcher": ["$rustc"]
    }
  ]
}
